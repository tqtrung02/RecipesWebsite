<form action="/reset-password/<%= token %>" method="POST" class="p-4">
    <div class="card shadow-sm">
        <div class="card-body">
            <h4 class="card-title text-center mb-4">Đổi Mật khẩu</h4>
            <div class="form-group mb-3">
                <label for="password" class="form-label">Mật khẩu mới</label>
                <input type="password" class="form-control" name="password" required placeholder="Nhập mật khẩu mới">
            </div>
            <button type="submit" class="btn btn-primary w-100 py-2 mt-3">Cập nhật mật khẩu</button>
        </div>
    </div>
</form>
