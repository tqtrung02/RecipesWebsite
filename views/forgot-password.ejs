<form action="/forgot-password" method="POST" class="p-4">
    <div class="card shadow-sm">
        <div class="card-body">
            <h4 class="card-title text-center mb-4">Quên mật khẩu?</h4>
            <div class="form-group mb-3">
                <label for="email" class="form-label">Nhập Email của bạn</label>
                <input type="email" class="form-control" name="email" required placeholder="Nhập email của bạn">
            </div>
            <button type="submit" class="btn btn-primary w-100 py-2 mt-3">Gửi link đổi mật khẩu</button>
        </div>
    </div>
</form>
