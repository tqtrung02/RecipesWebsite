<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title != 'undefined' ? title: 'FoodRecipes' %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" 
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@300;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body>

    <div class="container-xxl px-pm-5 bg-white shadow-lg">
        <!-- Header Section -->
        <header class="d-flex flex-wrap align-items-center justify-content-center justify-content-md-between py-3 mb-4 border-bottom" style="background-color: #f8f9fa;">
            <a href="/" class="d-flex align-items-center col-md-3 mb-2 mb-md-0 text-dark text-decoration-none">
                <img src="/img/recipes-book-kitchen-guide-svgrepo-com.svg" width="150" height="75" alt="FoodRecipes">
            </a>
    
            <div class="col-md-6 text-center">
                <% if (user) { %>
                  <div class="p-2 rounded-4 bg-light d-inline-block animate__animated animate__fadeInDown">
                    <h2 class="mb-0 fw-bold text-success fs-4">
                        Xin chào,
                      <span class="text-primary">
                        <%= user.name %>
                      </span>
                      <% if (user.role === 'admin') { %>
                        <i class="bi bi-shield-lock-fill ms-2" style="color: #dc3545;" title="Admin"></i>
                      <% } else { %>
                        <i class="bi bi-person-circle ms-2" style="color: #0d6efd;" title="User"></i>
                      <% } %>
                    </h2>
                  </div>
                <% } else { %>
                  <div class="p-2 rounded-4 bg-light d-inline-block animate__animated animate__fadeInDown">
                    <h2 class="mb-0 fw-bold text-warning fs-4">
                      Xin chào, khách tham quan!
                      <i class="bi bi-emoji-smile ms-2" style="color: #ffc107;" ></i>
                    </h2>
                  </div>
                <% } %>
            </div>
              
    
            <ul class="nav col-12 col-md-auto mb-2 justify-content-center mb-md-0" style="font-weight: 600;">
                <li><a href="/" class="nav-link px-2 link-secondary fs-5"><i class="bi bi-house-door-fill me-1"></i> Trang chủ</a></li>
                <li><a href="/submit-recipe" class="nav-link px-2 link-secondary fs-5"><i class="bi bi-upload me-1"></i> Đăng công thức</a></li>
            
                <% if (!user) { %>
                    <li><a href="/signup" class="nav-link px-2 link-secondary fs-5"><i class="bi bi-person-plus-fill me-1"></i> Đăng ký</a></li>
                    <li><a href="/login" class="nav-link px-2 link-secondary fs-5"><i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập</a></li>
                <% } %>
            
                <% if (user) { %>
                    <li><a href="/profile" class="nav-link px-2 link-secondary fs-5"><i class="bi bi-person-circle me-1"></i> Thông tin người dùng</a></li>
                    <li><a href="/my-recipes" class="nav-link px-2 link-secondary fs-5"><i class="bi bi-journal-text me-1"></i> Công thức của tôi</a></li>
                    <li><a href="/logout" class="nav-link px-2 link-secondary fs-5"><i class="bi bi-box-arrow-right me-1"></i> Đăng xuất</a></li>
                <% } %>
            </ul>
    
            <div class="col-md-3 text-end">
                <form method="POST" action="/search">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input type="search" name="searchTerm" class="form-control" placeholder="Tìm kiếm công thức..." aria-label="Search">
                    </div>
                </form>
            </div>
        </header>

        <!-- Admin Dashboard Button Below the Menu -->
        <% if (user && user.role === 'admin') { %>
            <div class="row justify-content-center mb-3">
                <div class="col-auto">
                    <a href="/admin/dashboard" class="btn btn-success d-flex align-items-center justify-content-center p-2 px-4 rounded-3 shadow-lg text-white fw-bold">
                        <i class="bi bi-house-door-fill me-2"></i> Admin Dashboard
                    </a>
                </div>
            </div>
        <% } %>

        <!-- Main Content -->
        <main>
            <%- body -%>
        </main>

        <!-- Footer Section -->
        <footer class="py-5 bg-light text-center mt-4">
            <p class="m-0">© 2025 FoodRecipes | All Rights Reserved</p>
        </footer>
    
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" 
    integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="/js/script.js"></script>
</body>
</html>
