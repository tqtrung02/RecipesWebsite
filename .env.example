# MongoDB Connection
# Local MongoDB:
MONGODB_URI=mongodb://localhost:27017/recipeswebsite
# MongoDB Atlas (Cloud):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/recipeswebsite

# Server Port
PORT=4000

# Google OAuth Credentials (Optional - only needed for Google login)
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Next.js Frontend URL (for redirects from Express backend)
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
